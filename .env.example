# ---- Database (required) ----
# A Postgres connection string. Free option: https://neon.tech
# (create a project, copy the "connection string"). Supabase also works.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Family invite code (optional but recommended) ----
# If set, new members must enter this code to register. Leave blank for open sign-up.
FAMILY_INVITE_CODE="our-family-2026"

# ---- Vision AI: identify a book from a cover photo (optional) ----
# Provider can be "anthropic" or "openai". Add the matching API key.
# If you leave the key blank, the app still works — you just type book details
# by hand (barcode scanning + ISBN lookup still work without any key).
VISION_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"   # optional override
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"                      # optional override

# ---- Sign in with Google (optional) ----
# Create an OAuth client at https://console.cloud.google.com (APIs & Services →
# Credentials → OAuth client ID → Web application). Add these redirect URIs:
#   http://localhost:3000/api/auth/google/callback   (local)
#   https://YOUR-APP.vercel.app/api/auth/google/callback   (production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" to show the "Continue with Google" button:
NEXT_PUBLIC_GOOGLE_ENABLED=""

# ---- Google Books (optional) ----
# Lookups work without a key. Add one only if you hit rate limits.
# GOOGLE_BOOKS_API_KEY=""
